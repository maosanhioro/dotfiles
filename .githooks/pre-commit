#!/usr/bin/env bash
# コミットに含まれるファイルを scripts/lint.sh で検査し、問題があればコミットを止める。
# Claude の編集直後の検査（.claude/hooks/）は Codex / Copilot の編集を拾えないため、
# 誰が編集してもコミット時に必ず通るここで受け止める。
# 有効化: install が git config core.hooksPath .githooks を設定する。一時的に飛ばすなら git commit --no-verify
set -euo pipefail

repo_dir="$(git rev-parse --show-toplevel)"

# 追加・変更されたファイルだけ。作業ツリー上の内容を検査する（部分ステージは考慮しない）
mapfile -t files < <(git diff --cached --name-only --diff-filter=ACMR)
[ "${#files[@]}" -gt 0 ] || exit 0

paths=()
for f in "${files[@]}"; do
  paths+=("$repo_dir/$f")
done

if ! "$repo_dir/scripts/lint.sh" "${paths[@]}"; then
  echo "pre-commit: 上の問題を直してからコミットしてください（一時的に飛ばすなら git commit --no-verify）" >&2
  exit 1
fi
